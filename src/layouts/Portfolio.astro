---
import '../styles/global.css';
import '../styles/responsive.css';
import { content } from '../data/site';
const { lang = 'en' } = Astro.props;
const t = content[lang as 'en' | 'ro'];
const target = lang === 'en' ? '/ro/' : '/en/';
const ids = ['artworks','practice','exhibitions','about','contact'];

const seoTitle = lang === 'ro' ? 'Sorin Iosub — Pictor și artist vizual român | Pictură și frescă' : 'Sorin Iosub — Romanian Contemporary Artist | Paintings & Frescoes';
const seoDescription = lang === 'ro' ? 'Descoperă picturile, grafica, frescele și expozițiile artistului vizual român Sorin Iosub.' : 'Explore paintings, graphic art, frescoes and exhibitions by Romanian visual artist Sorin Iosub.';
const seoCanonical = 'https://soriniosub.com/' + lang + '/';

const socialGraph = {'@context':'https://schema.org','@graph':[
 {'@type':'Person','@id':'https://soriniosub.com/#artist',name:'Sorin Iosub',url:'https://soriniosub.com/en/',image:'https://media.soriniosub.com/artist/sorin_portret.webp'},
 {'@type':'WebPage',url:seoCanonical,name:seoTitle,description:seoDescription,inLanguage:lang}
]};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={seoDescription} />
  <meta name="theme-color" content="#f6f4ef" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sorin Iosub" />
  <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={seoCanonical} />
  <meta property="og:image" content="https://media.soriniosub.com/artist/sorin_portret.webp" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://media.soriniosub.com" />
  <script type="application/ld+json" set:html={JSON.stringify(socialGraph)} />
  <title>{seoTitle}</title>
  <link rel="canonical" href={'https://soriniosub.com/' + lang + '/'} />
  <link rel="alternate" hreflang="en" href="https://soriniosub.com/en/" />
  <link rel="alternate" hreflang="ro" href="https://soriniosub.com/ro/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="brand" href={'/' + lang + '/'} aria-label="Sorin Iosub home">SORIN <span>IOSUB</span></a>
    <nav aria-label="Main navigation">{t.nav.map((item, i) => <a href={'#' + ids[i]}>{item}</a>)}</nav>
    <a class="lang" href={target}><img class="language-flag" src={lang === 'en' ? '/flags/ro.svg' : '/flags/gb.svg'} width="22" height="15" alt="" aria-hidden="true" /> {t.language}</a>
    <details class="mobile-menu">
      <summary aria-label={lang === 'ro' ? 'Deschide sau închide meniul' : 'Open or close navigation'}>
        <span class="menu-label">{lang === 'ro' ? 'Meniu' : 'Menu'}</span>
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      </summary>
      <nav aria-label={lang === 'ro' ? 'Navigare mobilă' : 'Mobile navigation'}>
        {t.nav.map((item, i) => <a href={'#' + ids[i]}>{item}</a>)}
        <a class="mobile-language" href={target}><img class="language-flag" src={lang === 'en' ? '/flags/ro.svg' : '/flags/gb.svg'} width="22" height="15" alt="" aria-hidden="true" /> {t.language}</a>
      </nav>
    </details>
  </header>
  <main id="content">
    <section class="hero section-pad">
      <div class="hero-copy"><p class="eyebrow"><span class="dot"></span>{t.eyebrow}</p><h1>{t.heroTitle}</h1><p class="intro">{t.heroCopy}</p><a class="primary-link" href="#artworks">{t.explore} </a></div>
      <div class="hero-art"><div class="abstract-sun"></div><div class="abstract-arch"></div><div class="abstract-person"></div><img class="hero-portrait" src="https://media.soriniosub.com/artist/sorin_portret.webp" width="720" height="484" loading="eager" decoding="async" alt={lang === "ro" ? "Pictură-portret expresivă în tonuri vibrante de roz, albastru și violet" : "Expressive portrait painting in vibrant pink, blue and violet tones"} /></div>
      
    </section>
    <section class="work-section section-pad" id="artworks"><div class="section-head"><div><p class="eyebrow">01 / {t.sectionLabels.portfolio}</p><h2>{t.workTitle}</h2></div><p>{t.workCopy}</p></div><div class="art-grid" data-r2-artworks={lang} aria-busy="true" aria-live="polite"><p class="artwork-message">{lang === 'ro' ? 'Se încarcă lucrările…' : 'Loading artworks…'}</p></div><p class="notice">{lang === 'ro' ? 'Titlurile și detaliile provizorii urmează să fie confirmate de artist.' : 'Provisional titles and details await confirmation by the artist.'}</p></section>
    <section class="practice-section section-pad" id="practice"><p class="eyebrow">02 / {t.sectionLabels.practice}</p><h2>{t.practice}</h2><div class="practice-grid"><article><span class="practice-num">01</span><h3><a class="practice-gallery-link" href={(lang === 'ro' ? '/ro/pictura-desen/' : '/en/painting-drawing/')}>{t.painting}</a></h3><p>{t.paintingCopy}</p><a class="practice-cta" href={(lang === 'ro' ? '/ro/pictura-desen/' : '/en/painting-drawing/')}>{lang === 'ro' ? 'Vezi galeria' : 'View gallery'}</a></article><article><span class="practice-num">02</span><h3><a class="practice-gallery-link" href={(lang === 'ro' ? '/ro/fresce-monumentale/' : '/en/frescoes-monumental/')}>{t.fresco}</a></h3><p>{t.frescoCopy}</p><a class="practice-cta" href={(lang === 'ro' ? '/ro/fresce-monumentale/' : '/en/frescoes-monumental/')}>{lang === 'ro' ? 'Vezi galeria' : 'View gallery'}</a></article></div></section>
    <section class="exhibition-section section-pad" id="exhibitions"><div class="section-head"><div><p class="eyebrow">03 / {t.sectionLabels.exhibitions}</p><h2>{t.exhibitions}</h2></div><p>{t.exhibitionsCopy}</p></div><div class="ex-row"><span>2026</span><div><h3>{t.ex1}</h3><p>{t.ex1copy}</p></div><a href="https://www.google.com/search?q=Sorin+Iosub+Muzeul+Apei+2026" target="_blank" rel="noopener noreferrer" aria-label={t.source + ' 2026'}>{t.source}</a></div><div class="ex-row"><span>2015</span><div><h3>{t.ex2}</h3><p>{t.ex2copy}</p></div><a href="https://www.google.com/search?q=Sorin+Iosub+40+Metafora+2015" target="_blank" rel="noopener noreferrer" aria-label={t.source + ' 2015'}>{t.source}</a></div></section>
    <section class="about-section section-pad" id="about"><p class="eyebrow">04 / {t.sectionLabels.artist}</p><div class="about-grid"><h2>{t.about}</h2><p>{t.aboutText}</p></div></section>
    <section class="contact-section section-pad" id="contact"><p class="eyebrow">05 / {t.sectionLabels.contact}</p><h2>{t.contact}</h2><p>{t.contactLead} <a href="mailto:soriniosub@yahoo.com">soriniosub@yahoo.com</a> {t.contactPhoneLead} <a href="tel:+40742589528">+40742589528</a>.</p><p class="social-line"><a href="https://www.facebook.com/sorin.iosub.9/?locale=ro_RO" target="_blank" rel="noopener noreferrer">Facebook</a></p></section>
  </main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} SORIN IOSUB</span><span>{t.rights}</span><a href="#content">{lang === 'ro' ? 'Sus' : 'Top'}</a></footer>
  <script src="/mobile.js" is:inline defer></script>
  <script src="/gallery.js?v=20261110-canvas1" is:inline defer></script>
</body>
</html>
