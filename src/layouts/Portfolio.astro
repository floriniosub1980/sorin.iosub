---
import '../styles/global.css';
import { content, works } from '../data/site';
const { lang = 'en' } = Astro.props;
const t = content[lang as 'en' | 'ro'];
const target = lang === 'en' ? '/ro/' : '/en/';
const ids = ['artworks','practice','exhibitions','about','contact'];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={t.heroCopy} />
  <meta name="theme-color" content="#f6f4ef" />
  <title>Sorin Iosub — {t.eyebrow}</title>
  <link rel="canonical" href={'https://soriniosub.com/' + lang + '/'} />
  <link rel="alternate" hreflang="en" href="https://soriniosub.com/en/" />
  <link rel="alternate" hreflang="ro" href="https://soriniosub.com/ro/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="brand" href={'/' + lang + '/'} aria-label="Sorin Iosub home">SORIN <span>IOSUB</span></a>
    <nav aria-label="Main navigation">{t.nav.map((item, i) => <a href={'#' + ids[i]}>{item}</a>)}</nav>
    <a class="lang" href={target}>{t.language} ↗</a>
  </header>
  <main id="content">
    <section class="hero section-pad">
      <div class="hero-copy"><p class="eyebrow"><span class="dot"></span>{t.eyebrow}</p><h1>{t.heroTitle}</h1><p class="intro">{t.heroCopy}</p><a class="primary-link" href="#artworks">{t.explore} <span>↗</span></a></div>
      <div class="hero-art" aria-label="Abstract graphic design placeholder"><div class="abstract-sun"></div><div class="abstract-arch"></div><div class="abstract-person"></div><span class="hero-caption">SORIN IOSUB / PORTFOLIO STUDY — 01</span></div>
      <div class="hero-index">01 / ARTIST PORTFOLIO</div>
    </section>
    <section class="work-section section-pad" id="artworks"><div class="section-head"><div><p class="eyebrow">01 / PORTFOLIO</p><h2>{t.workTitle}</h2></div><p>{t.workCopy}</p></div><div class="art-grid">{works.map((work, i) => <article class="art-card"><div class="art-frame" style={'--h:' + work.hue + ';--i:' + i}><span class="abstract-shape"></span><span class="art-marker">{String(i+1).padStart(2,'0')}</span></div><div class="art-info"><div><h3>{work.id}</h3><p>{t.availability}</p></div><span class="art-icon">↗</span></div></article>)}</div><p class="notice">{t.disclaimer}</p></section>
    <section class="practice-section section-pad" id="practice"><p class="eyebrow">02 / PRACTICE</p><h2>{t.practice}</h2><div class="practice-grid"><article><span class="practice-num">01</span><h3>{t.painting}</h3><p>{t.paintingCopy}</p></article><article><span class="practice-num">02</span><h3>{t.fresco}</h3><p>{t.frescoCopy}</p></article></div></section>
    <section class="exhibition-section section-pad" id="exhibitions"><div class="section-head"><div><p class="eyebrow">03 / ARCHIVE</p><h2>{t.exhibitions}</h2></div><p>{t.exhibitionsCopy}</p></div><div class="ex-row"><span>2026</span><div><h3>{t.ex1}</h3><p>{t.ex1copy}</p></div><a href="https://www.google.com/search?q=Sorin+Iosub+Muzeul+Apei+2026" target="_blank" rel="noopener noreferrer" aria-label={t.source + ' 2026'}>↗</a></div><div class="ex-row"><span>2015</span><div><h3>{t.ex2}</h3><p>{t.ex2copy}</p></div><a href="https://www.google.com/search?q=Sorin+Iosub+40+Metafora+2015" target="_blank" rel="noopener noreferrer" aria-label={t.source + ' 2015'}>↗</a></div></section>
    <section class="about-section section-pad" id="about"><p class="eyebrow">04 / ARTIST</p><div class="about-grid"><h2>{t.about}</h2><p>{t.aboutText}</p></div></section>
    <section class="contact-section section-pad" id="contact"><p class="eyebrow">05 / CONNECT</p><h2>{t.contact}</h2><p>{t.contactText}</p><span class="contact-pill">{t.contactButton} ↗</span><p class="social-line"><a href="https://www.facebook.com/sorin.iosub.9/?locale=ro_RO" target="_blank" rel="noopener noreferrer">Facebook ↗</a></p></section>
  </main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} SORIN IOSUB</span><span>{t.rights}</span><a href="#content">↑ TOP</a></footer>
</body>
</html>
